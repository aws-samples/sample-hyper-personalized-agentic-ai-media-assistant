# ---------------------------------------------------------------------------
# Frontend environment configuration for local development.
# Copy this file to `.env.local` and fill in the values from your deployment
# (infra/.artifacts/<name>/deployment.json, written by deploy.py).
# deploy.py sets every VITE_ variable itself for the hosted build.
# All Vite-exposed vars MUST be prefixed with VITE_.
# ---------------------------------------------------------------------------

# --- AWS / region ---
VITE_AWS_REGION=<your-region>
VITE_AWS_ACCOUNT_ID=<your-account-id>

# --- Cognito (auth): Application stack outputs UserPoolId / UserPoolClientId ---
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_IDENTITY_POOL_ID=

# --- REST API (API Gateway) base URL: Application stack output ApiUrl ---
VITE_API_BASE_URL=

# --- AgentCore runtimes: Application stack outputs *RuntimeArn ---
VITE_AGENTCORE_AGENT_ARN=
VITE_AGENTCORE_MATCH_ARN=

# --- Nova Sonic voice ---
# Local dev: point at the voice agent running on your machine (no auth).
# VITE_VOICE_WS_URL=ws://localhost:8081/ws
# Deployed: the voice agent's AgentCore runtime ARN (wss + token).
# VITE_AGENTCORE_VOICE_ARN=
# Verbose event logging in the browser console while developing.
# VITE_VOICE_DEBUG=true

# --- Live sports playback ---
# Paths under the site's /media/* behaviour (signed cookies from GET /media/session),
# uploaded by infra/deployment/load_media.py.
# VITE_LIVE_SPORTS_URL=/media/soccer/horizontal/football.mp4
# VITE_LIVE_SPORTS_URL_VERTICAL=/media/soccer/vertical/football.mp4

# --- Vertical clips feed (optional) ---
# Base URL for feed clips; the clips API returns presigned URLs, so this is
# normally left empty.
# VITE_MEDIA_BASE_URL=
