# Movie Voice Agent — environment configuration
#
# Copy to `.env` and fill in, or export in your shell. No secrets are required:
# the agent calls the movie recommendation agent using the *caller's* forwarded
# Cognito token (identity propagation), not a stored password.

# --- Required: the recommendation agent this voice agent calls ---
# ARN of your deployed movie recommendation AgentCore runtime.
# (Find it in backend/movie-ai-agent/.bedrock_agentcore.yaml -> agent_arn)
MOVIE_AGENT_ARN=arn:aws:bedrock-agentcore:us-east-1:<ACCOUNT_ID>:runtime/<runtime-name-id>

# --- Optional ---
# Region: defaults to the region parsed from MOVIE_AGENT_ARN, else AWS_REGION.
# MOVIE_AGENT_REGION=us-east-1
# Default personalization profile when the client doesn't send one.
# MOVIE_AGENT_PROFILE=rom-com_lover
# Movie-agent invoke timeout (seconds).
# MOVIE_AGENT_TIMEOUT=60

# --- Nova Sonic (voice) — optional, sensible defaults in app.py ---
# MODEL_ID=amazon.nova-2-sonic-v1:0
# BEDROCK_REGION=us-east-1
# SONIC_VOICE=tiffany                  # tiffany | matthew

# Note: AWS credentials (profile/role) are still needed for the Nova Sonic model
# calls themselves — locally via AWS_PROFILE, in the runtime via its exec role.
